# LiveTalking target machine environment file.
# Copy this file to ".env" (same folder as LiveTalkingServer.exe) and fill in
# your ElevenLabs credentials. The .env file is read at startup by config.py and
# tts/elevenlabs.py. NEVER ship or commit the real .env with filled-in keys.

# --- ElevenLabs (required) ---------------------------------------------------
# Get your API key at https://elevenlabs.io  (API Keys page).
ELEVENLABS_API_KEY=
# Voice ID to use for Vietnamese speech. Find voices in the ElevenLabs Voice
# Library (e.g. a cloned Vietnamese voice). Example format: 21m00Tcm4TlvDq8ikW...
ELEVENLABS_VOICE_ID=

# --- ElevenLabs model / format (MANDATORY — do not change) ------------------
# eleven_v3 is required for Vietnamese quality. Do NOT switch to
# eleven_multilingual_v2 (v2) — it is the library default and sounds worse for VN.
ELEVENLABS_MODEL_ID=eleven_v3
# 48kHz PCM -> fullband WebRTC audio (matches the ElevenLabs web demo, vs the
# old 16kHz telephony sound). Whisper/musetalk mel still runs at 16kHz
# internally (resampled), so lip-sync is unaffected. run_target.ps1 also sets
# this; keep pcm_48000 here so a customer .env copied from this example stays
# fullband. NOTE: pcm_44100 returns 403 on this key's tier ("Pro tier and
# above") but pcm_48000 is allowed, hence 48k. Use pcm_16000 only to roll back.
ELEVENLABS_OUTPUT_FORMAT=pcm_48000

# --- ElevenLabs optional tuning (defaults shown — safe to leave commented) --
# ELEVENLABS_SPEED=1.0
# ELEVENLABS_STABILITY=0.5
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.0
# ELEVENLABS_USE_SPEAKER_BOOST=true
# ELEVENLABS_MAX_RETRIES=3
# ELEVENLABS_TIMEOUT_SEC=60